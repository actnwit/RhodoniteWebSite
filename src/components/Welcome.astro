---
// トップページの組み立て。各セクションは React コンポーネント（src/components/home/）で実装している。
import { getImage } from 'astro:assets';
import { Code } from 'astro:components';
import { getLangFromUrl } from '../i18n/utils';
import { Hero } from './home/Hero';
import { CopyCommand } from './home/CopyCommand';
import { FeatureGrid } from './home/FeatureGrid';
import { QuickStart } from './home/QuickStart';
import { Showcase } from './home/Showcase';
import { EditorCta } from './home/EditorCta';
import { Community } from './home/Community';

import demoVideo from '../assets/RhodoniteDemos.mp4';
import demoPoster from '../assets/rhodonite_demos_poster.jpg';
import editorImage from '../assets/RhodoniteEditor.jpg';
import pbrImage from '../assets/screenshot_pbr.jpg';
import vrmImage from '../assets/screenshot_vrm.jpg';
import shaderImage from '../assets/screenshot_shader_node_editor.jpg';

const lang = getLangFromUrl(Astro.url);

const toWebp = async (src: ImageMetadata, width: number) => {
	const image = await getImage({ src, width: Math.min(width, src.width), format: 'webp' });
	return {
		src: image.src,
		width: Number(image.attributes.width ?? src.width),
		height: Number(image.attributes.height ?? src.height),
	};
};

const [poster, editor, pbr, vrm, shader] = await Promise.all([
	toWebp(demoPoster, 1280),
	toWebp(editorImage, 1600),
	toWebp(pbrImage, 800),
	toWebp(vrmImage, 800),
	toWebp(shaderImage, 800),
]);

const quickStartCode = `import Rn from 'rhodonite';

// Initialize Rhodonite with WebGPU (or Rn.ProcessApproach.WebGL2)
const engine = await Rn.Engine.init({
  approach: Rn.ProcessApproach.WebGPU,
  canvas: document.getElementById('world') as HTMLCanvasElement,
});

// Create a plane entity and rotate it
const plane = Rn.MeshHelper.createPlane(engine);
plane.eulerAngles = Rn.Vector3.fromCopy3(Math.PI * 0.5, 0, 0);

// Render the scene every frame
engine.startRenderLoop(() => {
  engine.processAuto();
});`;
---

<main>
	<Hero lang={lang} videoSrc={demoVideo} posterSrc={poster.src} videoLabel="Rhodonite · Demos">
		<CopyCommand client:idle lang={lang} />
	</Hero>
	<FeatureGrid lang={lang} />
	<QuickStart lang={lang} fileName="main.ts">
		<Code code={quickStartCode} lang="ts" theme="rose-pine" />
	</QuickStart>
	<Showcase lang={lang} images={{ pbr, vrm, shader }} />
	<EditorCta lang={lang} image={editor} />
	<Community lang={lang} />
</main>

<script>
	// ヒーロー動画は、ページの読み込み（JS・フォント・画像）が終わってから読み込み・再生を始める。
	// 「視覚効果を減らす」設定やデータセーバーが有効な場合は、ポスター画像のままにする。
	const video = document.getElementById('hero-video') as HTMLVideoElement | null;
	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData === true;

	if (video?.dataset.src && !reduceMotion && !saveData) {
		const src = video.dataset.src;
		const start = () => {
			video.src = src;
			video.play().catch(() => {
				// 自動再生がブロックされた場合はポスター表示のままにする
			});
		};
		const schedule = () => {
			if ('requestIdleCallback' in window) {
				window.requestIdleCallback(start, { timeout: 2000 });
			} else {
				setTimeout(start, 200);
			}
		};
		if (document.readyState === 'complete') {
			schedule();
		} else {
			window.addEventListener('load', schedule, { once: true });
		}
	}
</script>
